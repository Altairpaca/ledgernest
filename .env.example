# ===== LedgerNest 环境变量示例 =====
# 复制为 .env 并按需修改：cp .env.example .env

# --- 必填（生产）---
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# --- 安全 ---
DJANGO_DEBUG=false
# 逗号分隔；Tailnet 直连 IP 示例：100.x.y.z；也可直接 *
DJANGO_ALLOWED_HOSTS=*
# 逗号分隔；访问来源 Origin（http://100.x.y.z:8000）
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- 数据库（Docker Compose 环境自动使用 PostgreSQL）---
DB_ENGINE=postgres
DB_NAME=ledgernest
DB_USER=ledgernest
DB_PASSWORD=ledgernest
DB_HOST=db
DB_PORT=5432
# 本地开发（不用 Docker）时：DB_ENGINE 留空即可使用 SQLite

# --- 注册模式 ---
# open=任何人可注册；admin=仅管理员（/admin/create-user/）创建；closed=关闭
REGISTRATION_MODE=open

# --- 初始管理员（首次启动自动创建，幂等；已存在则跳过）---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_EMAIL=admin@example.com

# --- 业务默认值 ---
DEFAULT_CURRENCY=CNY
DJANGO_TIME_ZONE=Asia/Taipei
# 演示数据密码（仅开发环境使用 manage.py seed_demo）
DEMO_PASSWORD=ledgernest123
