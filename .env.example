# ===== LedgerNest 环境变量示例 =====
# 复制为 .env 后必须替换所有 CHANGE_ME 值：cp .env.example .env

# --- 必填（部署）---
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
# PostgreSQL 密码同样必须替换；docker-compose.yml 会拒绝空值。
DB_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_DB_PASSWORD

# --- 网络与安全 ---
DJANGO_DEBUG=false
# 默认只允许本机访问。Tailnet 部署时把这里和 BIND_ADDRESS 都改为本机 Tailscale IP。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8008,http://127.0.0.1:8008
LEDGERNEST_BIND_ADDRESS=127.0.0.1
LEDGERNEST_PORT=8008

# --- 数据库（Docker Compose 环境自动使用 PostgreSQL）---
DB_ENGINE=postgres
DB_NAME=ledgernest
DB_USER=ledgernest
DB_HOST=db
DB_PORT=5432
# 本地开发（不用 Docker）时：DB_ENGINE 留空即可使用 SQLite。

# --- 注册模式 ---
# closed=关闭注册；admin=仅管理员创建；open=任何人可注册。
# 部署默认关闭，只有明确需要自助注册时才改为 open。
REGISTRATION_MODE=closed

# --- 初始管理员（可选）---
# 仅首次启动使用。若配置密码，必须自行生成强随机值；不要使用示例密码。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# --- 业务默认值 ---
DEFAULT_CURRENCY=CNY
DJANGO_TIME_ZONE=Asia/Taipei
# 仅 manage.py seed_demo 的开发演示数据使用；部署环境不要设置。
DEMO_PASSWORD=
